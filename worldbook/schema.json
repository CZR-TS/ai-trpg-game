{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-trpg-game/worldbook/schema.json",
  "title": "AI TRPG Worldbook",
  "description": "兼容 SillyTavern 条目结构并包含共叙固定开场背景的世界书",
  "type": "object",
  "required": ["name", "opening_background", "entries"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "default": "" },
    "opening_background": {
      "type": "string",
      "minLength": 1,
      "description": "同一世界所有游戏共用的固定初始背景；角色创建完成后再由 AI 生成个性化第一回合"
    },
    "scan_depth": { "type": ["integer", "null"], "minimum": 0 },
    "token_budget": { "type": ["integer", "null"], "minimum": 0 },
    "recursive_scanning": { "type": "boolean", "default": true },
    "recursive_depth": { "type": "integer", "minimum": 0, "default": 2 },
    "extensions": { "type": "object", "default": {} },
    "entries": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["uid", "key", "content"],
      "additionalProperties": true,
      "properties": {
        "uid": { "type": "integer", "description": "条目唯一 id" },
        "key": { "type": "array", "items": { "type": "string" }, "description": "主关键词" },
        "keysecondary": { "type": "array", "items": { "type": ["string", "null"] } },
        "comment": { "type": "string" },
        "content": { "type": "string", "description": "正文，激活后注入" },
        "constant": { "type": "boolean", "default": false },
        "order": { "type": "integer", "default": 100 },
        "position": { "type": "integer", "default": 0, "enum": [0, 1, 2, 3, 4, 5, 6] },
        "disable": { "type": "boolean", "default": false },
        "probability": { "type": "integer", "minimum": 0, "maximum": 100, "default": 100 },
        "group": { "type": "string", "default": "" },
        "groupWeight": { "type": "integer", "default": 100 },
        "selective": { "type": "boolean", "default": true },
        "selectiveLogic": { "type": "integer", "default": 0, "enum": [0, 1, 2, 3] },
        "role": { "type": ["integer", "null"], "enum": [0, 1, 2, null] },
        "depth": { "type": "integer", "default": 4 },
        "caseSensitive": { "type": ["boolean", "null"], "default": null },
        "matchWholeWords": { "type": ["boolean", "null"], "default": null },
        "vectorized": { "type": "boolean", "default": false },
        "excludeRecursion": { "type": "boolean", "default": false },
        "preventRecursion": { "type": "boolean", "default": false },
        "delayUntilRecursion": { "type": "boolean", "default": false },
        "stickiness": { "type": "integer", "default": 0 },
        "cooldown": { "type": "integer", "default": 0 },
        "delay": { "type": "integer", "default": 0 }
      }
    }
  }
}
