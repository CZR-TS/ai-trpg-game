[Unit]
Description=Gongxu AI TRPG Game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trpg
Group=trpg
WorkingDirectory=/opt/ai-trpg-game/current
Environment=NODE_ENV=production
Environment=TRPG_HOST=0.0.0.0
Environment=TRPG_PORT=80
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/ai-trpg-game/shared

[Install]
WantedBy=multi-user.target
